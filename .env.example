# Copia este archivo como .env y cambia las claves por unas tuyas.
# Formato: mysql+pymysql://USUARIO:CLAVE@SERVIDOR:PUERTO/BASE_DE_DATOS

# Para Docker define ambas claves. Si el volumen existe, conserva sus claves actuales.
# Usa claves alfanuméricas largas para que puedan formar parte de la URL.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# Solo para arrancar la API fuera de Docker:
# DATABASE_URL=mysql+pymysql://grupo3:CLAVE@localhost:33061/db_kardex

# Clave para firmar los tokens de sesion (JWT).
# Genera una larga y aleatoria, por ejemplo: openssl rand -hex 32
SECRET_KEY=

# Duracion de la sesion en minutos (480 = 8 horas)
TOKEN_EXPIRE_MINUTES=480

# Activa únicamente en una instalación de demostración.
DEMO_DATA=false
